# Copie para .env.local para desenvolver. Em produção, cadastre as variáveis
# no painel da hospedagem (na Vercel: Settings → Environment Variables).
# Nunca faça commit dos valores reais.

# Banco (Turso). Sem estas duas, o Atol usa um arquivo SQLite local.
# TURSO_DATABASE_URL=libsql://atol-seu-usuario.turso.io
# TURSO_AUTH_TOKEN=

# Arquivo SQLite local, usado quando não há Turso. Padrão: data/atol.db
# ATOL_DB_PATH=./data/atol.db

# Endereço público do site, usado nos links enviados por e-mail.
# Obrigatório em produção para a recuperação de senha funcionar.
# SITE_URL=https://site-hub-pessoal.vercel.app

# E-mail (Resend). Sem estas duas, a recuperação de senha fica desligada em
# produção; em desenvolvimento o link aparece na própria tela.
# RESEND_API_KEY=
# EMAIL_FROM=Atol <nao-responda@seudominio.com>
